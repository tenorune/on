{
  "rules": {
    "userPrefs": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "notifyChannel": { ".validate": "newData.isString() && (newData.val() === 'push' || newData.val() === 'telegram')" }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "presence": {
          ".read": "auth != null",
          "code": { ".validate": "newData.isString() && newData.val().length <= 32" },
          "status": { ".validate": "newData.isString() && newData.val().length <= 16" },
          "statusColor": { ".validate": "newData.isString() && newData.val().length <= 64" },
          "paletteKey": { ".validate": "newData.isString() && newData.val().length <= 64" },
          "availableUntil": { ".validate": "newData.isNumber()" },
          "lastSeen": { ".validate": "newData.isNumber()" }
        },
        "invites": {
          "$token": {
            ".read": "auth != null",
            "redemptionsUsed": {
              ".write": "auth != null",
              ".validate": "newData.isNumber() && (auth.uid === $uid || newData.val() === (data.exists() ? data.val() : 0) + 1)"
            }
          }
        },
        "followers": {
          "$follower": {
            ".write": "auth != null && (auth.uid === $follower || auth.uid === $uid)",
            ".validate": "newData.isString() && newData.val().length <= 16"
          }
        },
        "followerNames": {
          "$follower": {
            ".write": "auth != null && (auth.uid === $follower || auth.uid === $uid)",
            ".validate": "newData.isString() && newData.val().length <= 40"
          }
        }
      }
    },
    "codeIndex": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((newData.exists() && newData.val() === auth.uid) || (!newData.exists() && data.val() === auth.uid))"
      }
    },
    "inviteIndex": {
      "$token": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('ownerUid').val() === auth.uid) || (!newData.exists() && (!data.child('ownerUid').exists() || data.child('ownerUid').val() === auth.uid)))",
        ".validate": "newData.hasChildren(['ownerPath', 'ownerUid']) && newData.child('ownerPath').isString() && newData.child('ownerUid').val() === auth.uid"
      }
    },
    "groupIdIndex": {
      "$gid": { ".read": "auth != null", ".write": "auth != null && !data.exists()" }
    },
    "groups": {
      "$gid": {
        ".read": "auth != null && data.child('members').child(auth.uid).exists()",
        ".write": "auth != null && (data.child('ownerId').val() === auth.uid || newData.child('ownerId').val() === auth.uid)",
        "name": { ".read": "auth != null", ".validate": "newData.isString() && newData.val().length <= 64" },
        "ownerId": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "color": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "paletteKey": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "invites": {
          "$token": {
            ".read": "auth != null",
            "redemptionsUsed": {
              ".write": "auth != null",
              ".validate": "newData.isNumber() && (root.child('groups').child($gid).child('ownerId').val() === auth.uid || newData.val() === (data.exists() ? data.val() : 0) + 1)"
            }
          }
        },
        "members": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && (auth.uid === $uid || data.parent().parent().child('ownerId').val() === auth.uid)"
          }
        }
      }
    },
    "knocks": {
      "$recipient": {
        ".read": "auth != null && auth.uid === $recipient",
        "$sender": {
          ".read": "auth != null && (auth.uid === $sender || auth.uid === $recipient)",
          ".write": "auth != null && (auth.uid === $sender || auth.uid === $recipient)",
          ".validate": "newData.hasChildren(['count', 'ts'])",
          "count": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5" },
          "ts": { ".validate": "newData.isNumber()" },
          "contextGroupId": { ".validate": "newData.isString() && newData.val().matches(/^[A-Z0-9]{8}$/)" },
          "$other": { ".validate": false }
        }
      }
    },
    "revocations": {
      "$revoked": {
        ".read": "auth != null && auth.uid === $revoked",
        "$revoker": {
          ".write": "auth != null && (auth.uid === $revoker || auth.uid === $revoked)",
          ".validate": "newData.val() === true"
        }
      }
    },
    "followRequests": {
      "$target": {
        ".read": "auth != null && auth.uid === $target",
        "$requester": {
          ".write": "auth != null && (auth.uid === $requester || auth.uid === $target)",
          ".validate": "newData.hasChildren(['from', 'ts']) && newData.child('from').val() === $requester",
          "from": { ".validate": "newData.isString()" },
          "groupId": { ".validate": "newData.isString() && newData.val().length <= 64" },
          "ts": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },
    "followGrants": {
      "$requester": {
        ".read": "auth != null && auth.uid === $requester",
        "$target": {
          ".write": "auth != null && (auth.uid === $target || auth.uid === $requester)",
          ".validate": "newData.hasChildren(['from', 'ts']) && newData.child('from').val() === $target",
          "from": { ".validate": "newData.isString()" },
          "code": { ".validate": "newData.isString() && newData.val().length <= 16" },
          "name": { ".validate": "newData.isString() && newData.val().length <= 64" },
          "ts": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },
    "pendingInvites": {
      "$invitee": {
        ".read": "auth != null && auth.uid === $invitee",
        "$group": {
          ".write": "auth != null && ((newData.exists() && newData.child('from').val() === auth.uid && root.child('groups').child($group).child('members').child(auth.uid).exists()) || auth.uid === $invitee || (!newData.exists() && data.child('from').val() === auth.uid))",
          ".validate": "newData.hasChildren(['from', 'ts'])",
          "from": { ".validate": "newData.isString()" },
          "ts": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },
    "pendingInvitesByGroup": {
      "$group": {
        ".read": "auth != null && root.child('groups').child($group).child('members').child(auth.uid).exists()",
        "$invitee": {
          ".write": "auth != null && (root.child('groups').child($group).child('members').child(auth.uid).exists() || auth.uid === $invitee)",
          ".validate": "newData.val() === true"
        }
      }
    },
    "calls": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || (newData.exists() && (newData.child('from').val() === auth.uid || newData.child('to').val() === auth.uid)) || (data.exists() && (data.child('from').val() === auth.uid || data.child('to').val() === auth.uid)))",
        ".validate": "newData.hasChildren(['ts'])",
        "from": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "to": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "ts": { ".validate": "newData.isNumber()" },
        "answered": { ".validate": "newData.isBoolean()" },
        "$other": { ".validate": false }
      }
    },
    "canvases": {
      "$canvasId": {
        ".read": "auth != null && ($canvasId.beginsWith(auth.uid + '_') || $canvasId.endsWith('_' + auth.uid))",
        ".write": "auth != null && ($canvasId.beginsWith(auth.uid + '_') || $canvasId.endsWith('_' + auth.uid))"
      }
    },
    "notifierState": { ".read": false, ".write": false },
    "telegramUsers": { ".read": false, ".write": false },
    "telegramByUid": { ".read": false, ".write": false },
    "telegramLinkTokens": { ".read": false, ".write": false },
    "$other": { ".read": false, ".write": false }
  }
}
