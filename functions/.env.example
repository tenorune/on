# Per-project Firebase Functions config.
#
# The Firebase CLI auto-loads functions/.env.<projectId> at deploy time, selected
# by the deploy's --project flag (e.g. functions/.env.on-on-22cb4 for dev). These
# files are NOT secret and ARE committed (only `.env`, `.env.local`, `.env.production`
# are gitignored). Copy this file to functions/.env.<projectId> per environment.
#
# FUNCTIONS_REGION MUST match that project's Realtime Database region — a 2nd-gen
# RTDB trigger can only be created in the same region as the database instance.
# If unset, the code defaults to europe-west1 (the dev RTDB region).
#
# Example for a EU project:
FUNCTIONS_REGION=europe-west1

# When wiring up prod (project `knock-knock`), create functions/.env.<prod-projectId>
# with FUNCTIONS_REGION set to the PROD RTDB's region (confirm it from the prod
# databaseURL before the first prod deploy).
